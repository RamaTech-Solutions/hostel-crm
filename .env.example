# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (for seed scripts — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL used for Auth email redirects (signup confirmation)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only demo login (never prefix with NEXT_PUBLIC_)
DEMO_OWNER_EMAIL=owner@demo-hostel.com
DEMO_OWNER_PASSWORD=

# Optional: set to 1 to run live RLS smoke tests (requires a non-production DB)
# SUPABASE_RLS_TEST=1
