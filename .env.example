# Supabase (local/staging — never production for seed)
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (seed / smoke locally — NEVER add to Vercel or NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# This deployment's origin (Auth emails, metadata). Never leave Preview on the production hostname.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production landing: set to the stable staging demo, e.g. https://<stable-staging>/demo
# Local/Preview: omit to use /demo on this host
# NEXT_PUBLIC_DEMO_URL=

# Staging/Preview demo Start Free: production origin, e.g. https://hostel-crm.vercel.app
# Production: omit so Start Free stays /signup on this host
# NEXT_PUBLIC_PRIMARY_APP_URL=

# Server-only demo login (Preview + local only — omit on Production)
DEMO_OWNER_EMAIL=owner@demo-hostel.com
DEMO_OWNER_PASSWORD=

# Seed guards (staging only). Both required. Never seed production.
# ALLOW_DEMO_SEED=1
# CONFIRM_SUPABASE_PROJECT_REF=your-staging-ref
# PRODUCTION_SUPABASE_PROJECT_REF=your-production-ref

# Optional: set to 1 to run live RLS smoke tests (non-production DB only)
# SUPABASE_RLS_TEST=1
